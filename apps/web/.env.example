# Vercel same-origin API alias. The deployed API is also available at /api/v1.
NEXT_PUBLIC_API_URL="/vercel/api"

# Public Turnstile site key. Configure the matching private key in the API environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"

# For local development, override NEXT_PUBLIC_API_URL with http://localhost:4110/api/v1.