# Copy these values into the API environment. Never commit real credentials.
PORT=4110

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="replace-with-supabase-secret-key"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Use the Supabase transaction pooler for serverless DATABASE_URL and direct Postgres for migrations.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

JWT_SECRET="replace-with-a-long-random-secret"
FINGERPRINT_PEPPER="replace-with-a-different-long-random-secret"
COOKIE_SECRET="replace-with-another-long-random-secret"
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Private Google Sheets support. Set either GOOGLE_SERVICE_ACCOUNT_JSON or both split variables.
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@YOUR_PROJECT_ID.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative for deployments that inject one JSON secret:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"service-account@YOUR_PROJECT_ID.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"}

# Use a hosted Redis URL with TLS (rediss://) for Vercel, not localhost.
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379"

# Cross-origin access only; same-origin Vercel requests do not require CORS.
CORS_ALLOWED_ORIGINS="https://YOUR_PROJECT.vercel.app,https://YOUR_CUSTOM_DOMAIN"

# SMTP is required for new-device OTP, registration approval, and account notifications.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="YOUR_SMTP_USER"
SMTP_FROM="JAMUS KALIMASADA <YOUR_FROM_ADDRESS>"
SMTP_PASSWORD="replace-with-smtp-password"

# Set TURNSTILE_SECRET_KEY here and NEXT_PUBLIC_TURNSTILE_SITE_KEY in the web environment.
TURNSTILE_SECRET_KEY="replace-with-cloudflare-turnstile-secret-key"
