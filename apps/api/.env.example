# Use either GOOGLE_SERVICE_ACCOUNT_JSON or the two split variables below.
# Never commit a real service-account key or private key.
PORT=4110

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="replace-with-your-supabase-publishable-key"
SUPABASE_SECRET_KEY="replace-with-your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
FINGERPRINT_PEPPER="replace-with-a-long-random-secret"
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative for deployments that inject one JSON secret:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}

REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-prod-secret"
SESSION_SECRET="replace-with-session-secret"
NODE_ENV="development"

# SMTP is required when a login is attempted from a new device fingerprint.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@example.com"
SMTP_FROM="your-email@example.com"
SMTP_PASSWORD="replace-with-a-gmail-app-password"

# Cloudflare Turnstile bot protection
TURNSTILE_SECRET_KEY="replace-with-your-turnstile-secret-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-your-turnstile-site-key"
